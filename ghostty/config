# vim: set ft=conf

# Font configuration:
# font-family = "Hasklug Nerd Font Mono Med"
# font-family-italic = "Cartograph CF Italic"
# adjust-cell-width = -5%
# adjust-cell-height = 20%
# adjust-underline-position = 6
# adjust-underline-thickness = 40%
# adjust-cursor-thickness = 150%
font-size = 14

# Color theme
theme = tokyonight-storm
# theme = Dracula
# background = 0E1419
background-opacity = 0.95
background-blur = 10
unfocused-split-opacity = 0.62

# Cursor:
# cursor-color = F8F8F2
# cursor-style-blink = false
# cursor-text = 000000
# shell-integration-features = no-cursor
# shell-integration = zsh
# shell-integration-features = no-cursor,sudo,no-title

# Key bindings:
keybind = alt+one=goto_tab:1
keybind = alt+two=goto_tab:2
keybind = alt+three=goto_tab:3
keybind = alt+four=goto_tab:4
keybind = alt+five=goto_tab:5
keybind = alt+shift+t=new_tab
keybind = alt+shift+comma=reload_config
keybind = alt+shift+q=close_surface
keybind = alt+shift+i=inspector:toggle
keybind = alt+equal=increase_font_size:1
keybind = alt+minus=decrease_font_size:1
keybind = alt+zero=reset_font_size
keybind = alt+shift+v=new_split:right
keybind = alt+shift+s=new_split:down
keybind = alt+shift+k=goto_split:top
keybind = alt+shift+j=goto_split:bottom
keybind = alt+shift+h=goto_split:left
keybind = alt+shift+l=goto_split:right
keybind = alt+shift+c=copy_to_clipboard
keybind = alt+shift+b=write_screen_file:paste
keybind = alt+shift+enter=toggle_fullscreen

confirm-close-surface = false




# Title bar font:
# window-title-font-family = "Hasklug Nerd Font Mono Med"

# The style of the macOS titlebar. Available values are: "native",
# "transparent", "tabs", and "hidden". macos-titlebar-style = "transparent"
macos-titlebar-style = "hidden"

# Treat the option key as alt
macos-option-as-alt = true

# No shadow -> looks cleaner
macos-window-shadow = false

# Stop Ghostty when closing everything.
quit-after-last-window-closed = true

mouse-hide-while-typing = true

clipboard-read = allow
clipboard-write = allow

link-url = true
